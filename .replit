entrypoint = "index.html"
modules = ["nodejs-20"]

[workflows]
  runButton = "Dev with Live Reload"

[[workflows.workflow]]
  name = "Dev with Live Reload"
  mode = "parallel"

[[workflows.workflow.tasks]]
  task = "shell.exec"
  args = """
    echo '🚀 Starting live-server at http://localhost:3000...'
    npm run dev
  """
  waitForPort = 3000

[[ports]]
  localPort = 3000
  externalPort = 3000