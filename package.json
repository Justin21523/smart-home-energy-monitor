{
  "name": "smart-home-energy-monitor",
  "version": "1.0.0",
  "description": "Smart home energy dashboard with live reload using live-server",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --host=0.0.0.0 --port=3000 --watch=.",
    "demo:dev": "python3 -m http.server 4173 --directory demo-app",
    "demo:build": "node -e \"require('fs').accessSync('demo-app/index.html')\"",
    "demo:preview": "python3 -m http.server 4173 --directory demo-app",
    "build": "npm --prefix demo-app run build"
  },
  "devDependencies": {
    "live-server": "^1.2.0",
    "three": "^0.178.0"
  },
